{
  "permissions": {
    "allow": [
      "Bash(Rscript:*)",
      "Bash(quarto:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Bash('/c/Program Files/R/R-4.5.3/bin/Rscript.exe' -e ' *)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{ts: now, agent: .tool_input.subagent_type, prompt: .tool_input.prompt}' >> logs/execucao.jsonl"
          }
        ]
      }
    ]
  }
}
